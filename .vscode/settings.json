{
  // ── Python interpreter ──────────────────────────────────────────────────────
  // VS Code will auto-detect the system Python. If you use a virtual environment,
  // update this path to point at your venv interpreter, for example:
  //   "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"
  "python.defaultInterpreterPath": "python3",

  // ── Terminal ─────────────────────────────────────────────────────────────────
  // Set the working directory for the integrated terminal to the ozzoo/ sub-folder
  // so that `python main.py` works without any cd.
  "terminal.integrated.cwd": "${workspaceFolder}/ozzoo",

  // ── Editor helpers ───────────────────────────────────────────────────────────
  "editor.formatOnSave": true,
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.formatOnSave": false
  },
  "python.analysis.extraPaths": [
    "${workspaceFolder}/ozzoo"
  ]
}
